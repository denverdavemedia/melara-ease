# Copy the real values from shopmelara-apex/.env into a file named .env (git-ignored).

# CRM credential
KONNEKTIVE_LOGIN_ID=
KONNEKTIVE_PASSWORD=

# DEEPL key (auto-translates new lang/*.json keys on localhost)
DEEPL_KEY=

# Stripe sandbox and production keys
SANDBOX_PUBLICKEY=
SANDBOX_SECRETKEY=
LIVE_PUBLICKEY=
LIVE_SECRETKEY=

# Everflow API key and timezone
EVERFLOW_API_KEY=
EVERFLOW_TIMEZONE=
